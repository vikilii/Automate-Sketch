{
  "name": "Automate Sketch Compatibility Tests",
  "identifier": "com.automate-sketch.compatibility-tests",
  "version": "1.0",
  "commands": [
    {
      "name": "Run Tests",
      "identifier": "run-tests",
      "script": "runner.js",
      "handler": "onRun"
    },
    {
      "name": "Create Fixture",
      "identifier": "create-fixture",
      "script": "runner.js",
      "handler": "createFixture"
    }
  ]
}